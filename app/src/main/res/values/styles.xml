<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
    </style>

    <style name="AppTheme.Button2" parent="Widget.AppCompat.Button.Colored">
        <item name="colorButtonNormal">@color/blueMaterial</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="BottomNavText" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">12dp</item> <!-- Tambah jarak antara icon dan teks -->
    </style>

    <style name="UserCellStyle">
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="cr6">
        <item name="cornerSize">6dp</item>
    </style>
    <style name="cr4">
        <item name="cornerSize">4dp</item>
    </style>
    <style name="cr12">
        <item name="cornerSize">12dp</item>
    </style>

</resources>