<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_card_balita"
    android:layout_marginBottom="8dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_gray"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="25dp"/>


    <!-- ======== HEADER (klik untuk buka/tutup detail) ======== -->
    <LinearLayout
        android:id="@+id/headerLayoutDataKeluarga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Foto anak -->
        <ImageView
            android:id="@+id/imgBalita"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_light"
            android:padding="6dp"
            android:layout_marginEnd="10dp" />

        <!-- Nama + Umur -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNamaBalita"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rizky Karangturi"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvNamaIbu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ibu: Siti Karangturi"
                android:textSize="12sp"
                android:textColor="@color/dark_gray" />
        </LinearLayout>

        <!-- Kecamatan + Posyandu -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvNamaKecamatan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:paddingHorizontal="8dp"
                android:text="Karangturi"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/birumuda"
                android:backgroundTint="@color/tipisbirumuda"
                android:background="@drawable/bg_status_gizi" />

            <TextView
                android:id="@+id/tvNamaPosyandu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cempaka 1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/hijau"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ======== DETAIL (expand saat diklik) ======== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detailLayoutKeluarga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:visibility="gone"
        android:nestedScrollingEnabled="false"
        >



        <!-- ================= GUIDELINES ================= -->
        <!-- Untuk 2 kolom -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <!-- Untuk 3 kolom -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline33"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.33" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline66"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.66" />

        <!-- ================= BARIS 1 ================= -->
        <!-- No KK -->
        <TextView
            android:id="@+id/labelNoKK"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="No KK"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline50"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvNoKK"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="3300112201030005"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/labelNoKK"
            app:layout_constraintEnd_toEndOf="@id/labelNoKK"
            app:layout_constraintTop_toBottomOf="@id/labelNoKK"/>

        <!-- Status Ekonomi -->
        <TextView
            android:id="@+id/labelStatusEkonomi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Status Ekonomi"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/guideline50"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/labelNoKK"/>

        <TextView
            android:id="@+id/tvStatusEkonomi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sedang"
            android:textSize="13sp"
            android:textColor="@color/orangetua"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/labelStatusEkonomi"
            app:layout_constraintEnd_toEndOf="@id/labelStatusEkonomi"
            app:layout_constraintTop_toBottomOf="@id/labelStatusEkonomi"/>

        <!-- ================= BARIS 2 ================= -->
        <!-- Alamat -->
        <TextView
            android:id="@+id/labelAlamat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Alamat"
            android:textSize="13sp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline33"
            app:layout_constraintTop_toBottomOf="@id/tvNoKK"/>

        <TextView
            android:id="@+id/tvAlamat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Desa Karangturi"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/labelAlamat"
            app:layout_constraintEnd_toEndOf="@id/labelAlamat"
            app:layout_constraintTop_toBottomOf="@id/labelAlamat"/>

        <!-- RT / RW -->
        <TextView
            android:id="@+id/labelRTRW"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="RT / RW"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/guideline33"
            app:layout_constraintEnd_toStartOf="@id/guideline66"
            app:layout_constraintTop_toTopOf="@id/labelAlamat"/>

        <TextView
            android:id="@+id/tvRTRW"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="001/001"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/labelRTRW"
            app:layout_constraintEnd_toEndOf="@id/labelRTRW"
            app:layout_constraintTop_toBottomOf="@id/labelRTRW"/>

        <!-- Jumlah Anak -->
        <TextView
            android:id="@+id/labelJumlahAnak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Jumlah Anak"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/guideline66"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/labelAlamat"/>

        <TextView
            android:id="@+id/tvJumlahAnak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="2"
            android:textSize="13sp"
            android:textColor="@color/blueMaterial"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/labelJumlahAnak"
            app:layout_constraintEnd_toEndOf="@id/labelJumlahAnak"
            app:layout_constraintTop_toBottomOf="@id/labelJumlahAnak"/>

        <!-- ================= BARIS 3 ================= -->
        <!-- Tahapan KS -->
        <TextView
            android:id="@+id/labelTahapanKS"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tahapan KS"
            android:textSize="13sp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline50"
            app:layout_constraintTop_toBottomOf="@id/tvAlamat"/>

        <TextView
            android:id="@+id/tvTahapanKS"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="KS I"
            android:textSize="13sp"
            android:textColor="@color/merah"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/labelTahapanKS"
            app:layout_constraintEnd_toEndOf="@id/labelTahapanKS"
            app:layout_constraintTop_toBottomOf="@id/labelTahapanKS"/>

        <!-- Status KEK Ibu -->
        <TextView
            android:id="@+id/labelStatusKEKIbu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Status KEK Ibu"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="@id/guideline33"
            app:layout_constraintEnd_toStartOf="@id/guideline66"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/labelTahapanKS"/>

        <TextView
            android:id="@+id/tvStatusKEKIbu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kondisi Sehat"
            android:textSize="13sp"
            android:textColor="@color/hijau"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/labelStatusKEKIbu"
            app:layout_constraintEnd_toEndOf="@id/labelStatusKEKIbu"
            app:layout_constraintTop_toBottomOf="@id/labelStatusKEKIbu"/>

        <!-- ================= BUTTON ================= -->
        <Button
            android:id="@+id/btnUbah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_greentosca"
            android:text="Ubah"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvTahapanKS"
            app:layout_constraintEnd_toEndOf="parent"/>

        <Button
            android:id="@+id/btnLihat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:text="Lihat"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_biru"

            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toTopOf="@id/btnUbah"
            app:layout_constraintEnd_toStartOf="@id/btnUbah"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
