<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F9FAFB"
    tools:context=".admin.LaporanFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Judul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laporan Bulanan"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="16dp" />

        <!-- Card utama -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Subjudul -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter &amp; Generate Laporan"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:drawableLeft="@drawable/frame_logo"
                    android:drawablePadding="8dp"
                    android:textColor="#111827"
                    android:layout_marginBottom="8dp" />

                <!-- Garis pemisah -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB"
                    android:layout_marginBottom="12dp" />

                <!-- Inner Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    android:backgroundTint="#F9FAFB"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Filter Laporan Bulanan"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:textSize="15sp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilih periode dan jenis laporan yang ingin digenerate"
                            android:textColor="#6B7280"
                            android:textSize="13sp"
                            android:layout_marginBottom="12dp"/>

                        <!-- Dari Bulan -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dari Bulan*"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#374151"
                            android:layout_marginTop="4dp" />

                        <Spinner
                            android:id="@+id/spinnerDariBulan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_spinner" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilih bulan awal periode laporan"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp"/>

                        <!-- Sampai Bulan -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sampai Bulan*"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#374151" />

                        <Spinner
                            android:id="@+id/spinnerSampaiBulan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_spinner" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilih bulan akhir periode laporan"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp"/>

                        <!-- Tahun -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tahun*"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#374151" />

                        <Spinner
                            android:id="@+id/spinnerTahun"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_spinner" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilih tahun laporan"
                            android:textColor="#9CA3AF"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp"/>

                        <!-- Jenis Laporan -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jenis Laporan"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#374151" />

                        <Spinner
                            android:id="@+id/spinnerJenisLaporan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:minHeight="48dp"
                            android:background="@drawable/bg_spinner" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilih satu atau lebih jenis laporan untuk melihat preview. Setiap jenis akan dibuat dalam sheet terpisah."
                            android:textColor="#9CA3AF"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp"/>

                        <!-- Tombol Generate -->
                        <Button
                            android:id="@+id/btnGenerate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Generate &amp; Download Excel"
                            android:textAllCaps="false"
                            android:backgroundTint="#22C55E"
                            android:textColor="#FFFFFF"
                            android:drawableLeft="@drawable/baseline_arrow_back_24"
                            android:drawablePadding="8dp"
                            android:paddingVertical="10dp"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
