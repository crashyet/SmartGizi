<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_weclome"
    android:layout_marginBottom="8dp">

    <!-- Header (klik bagian ini untuk expand/collapse) -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/frame_logo"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_top"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rizky Karangturi"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20 Mei 2020 • Laki-laki"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gizi Normal"
            android:textColor="@color/hijau"
            android:textStyle="bold"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Detail (expand/collapse) -->
    <LinearLayout
        android:id="@+id/detailLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:padding="8dp"
        android:background="@color/white">

        <TextView
            android:id="@+id/tvBB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BB: 12 kg"/>

        <TextView
            android:id="@+id/tvTB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TB: 95 cm"/>

        <TextView
            android:id="@+id/tvPetugas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Petugas: Kader Cempaka 1"/>

        <TextView
            android:id="@+id/tvGizi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status Gizi: Normal"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"/>

            <Button
                android:id="@+id/btnGrafik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grafik"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
