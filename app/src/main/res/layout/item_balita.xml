<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_card_balita"
    android:layout_marginBottom="8dp">

    <!-- ======== HEADER (klik untuk buka/tutup detail) ======== -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <!-- Foto / Icon anak -->
        <ImageView
            android:id="@+id/imgBalita"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_stafkader"
            android:background="@drawable/bg_circle_light"
            android:padding="6dp"
            android:layout_marginEnd="10dp"/>

        <!-- Info utama -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Eko Gentasari"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/tvTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08 Oktober 2025 • 11 bln"
                android:textColor="@color/dark_gray"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Status gizi -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            android:paddingHorizontal="8dp"
            android:text="Normal"
            android:textColor="@color/hijau"
            android:textSize="12sp"
            android:backgroundTint="@color/tipishijau"
            android:background="@drawable/bg_status_gizi"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ======== DETAIL (expand saat diklik) ======== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/detailLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- BB -->
        <TextView
            android:id="@+id/labelBB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="BB"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/labelTB"
            app:layout_constraintHorizontal_chainStyle="spread"/>

        <TextView
            android:id="@+id/tvBB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9 kg"
            android:textSize="13sp"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/labelBB"
            app:layout_constraintStart_toStartOf="@id/labelBB"/>

        <!-- TB -->
        <TextView
            android:id="@+id/labelTB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TB"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/labelBB"
            app:layout_constraintEnd_toStartOf="@id/labelPetugas"/>

        <TextView
            android:id="@+id/tvTB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="80 cm"
            android:textSize="13sp"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/labelTB"
            app:layout_constraintStart_toStartOf="@id/labelTB"/>

        <!-- Petugas -->
        <TextView
            android:id="@+id/labelPetugas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Level Risiko"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/labelTB"
            app:layout_constraintEnd_toStartOf="@id/tvGizi"/>

        <TextView
            android:id="@+id/tvPetugas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rendah"
            android:textSize="13sp"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/labelPetugas"
            app:layout_constraintStart_toStartOf="@id/labelPetugas"/>

        <TextView
            android:id="@+id/labelStatusGizi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Level Risiko"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/labelTB"
            app:layout_constraintEnd_toStartOf="@id/tvGizi"/>

        <!-- Status Gizi -->
        <TextView
            android:id="@+id/tvGizi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gizi Baik"
            android:textSize="13sp"
            android:textColor="@color/hijau"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Posisi Menimbang -->
        <TextView
            android:id="@+id/tvPosisiMenimbang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Berdiri"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvBB"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:paddingTop="21dp"/>

        <!-- Umur Balita (sejajar kanan posisi menimbang) -->
        <TextView
            android:id="@+id/tvUmurBalita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2th 2bln 3hari"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@id/tvPosisiMenimbang"
            app:layout_constraintStart_toEndOf="@id/tvPosisiMenimbang"
            android:layout_marginStart="16dp"
            android:layout_marginTop="21dp"/>


        <!-- Tombol aksi di bawah -->
        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvTB"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingVertical="6dp"
                android:paddingHorizontal="12dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="@color/orangetua"
                android:layout_marginStart="8dp"/>

            <Button
                android:id="@+id/btnGrafik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingVertical="6dp"
                android:paddingHorizontal="12dp"
                android:text="Grafik"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:backgroundTint="@color/hijau"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>