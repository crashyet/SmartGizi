<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna background putih -->
    <solid android:color="#FFFFFFFF" />

    <!-- Rounded corner -->
    <corners android:radius="12dp" />

    <!-- Sedikit shadow / elevasi simulasi -->
    <padding
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp" />

    <!-- Border transparan untuk efek halus -->
    <stroke
        android:width="1dp"
        android:color="#10AAAAAA" />
</shape>